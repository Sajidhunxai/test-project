---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import CartBadge from "../components/store/CartBadge";
import AuthBadge from "../components/store/AuthBadge";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/store.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const normalizeNavUrl = (url: string) => {
	const path = url.split("?")[0]?.split("#")[0] ?? url;
	if (path.length > 1 && path.endsWith("/")) return path.slice(0, -1);
	return path || "/";
};

const aboutFromMenu = menu?.items?.find(
	(item) =>
		item.label.toLowerCase() === "about" ||
		normalizeNavUrl(item.url) === "/about",
);

const primaryNav = [
	{ label: "Home", url: "/" },
	{ label: "Store", url: "/store" },
	{ label: "About", url: aboutFromMenu?.url ?? "/about" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav" aria-label="Primary">
				<a href="/" class="site-title">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="site-logo-img"
							/>
						) : (
							siteTitle
						)
					}
				</a>

				<div class="nav-cluster">
					<div class="site-search-wrap">
						<LiveSearch
							placeholder="Search..."
							class="site-search"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages"]}
						/>
					</div>
					<div class="nav-links">
						{
							primaryNav.map((item) => (
								<a href={item.url}>{item.label}</a>
							))
						}
						<AuthBadge client:load />
					</div>
				</div>

				<div class="nav-toolbar">
					<div class="nav-toolbar-extra">
						<div
							class="theme-switcher theme-switcher--nav"
							role="group"
							aria-label="Color theme"
						>
							<button
								type="button"
								class="theme-btn"
								data-theme="light"
								aria-label="Light mode"
							>
								<svg
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									><circle cx="12" cy="12" r="5"></circle><line
										x1="12"
										y1="1"
										x2="12"
										y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
									></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
									></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
									></line><line x1="1" y1="12" x2="3" y2="12"></line><line
										x1="21"
										y1="12"
										x2="23"
										y2="12"></line><line
										x1="4.22"
										y1="19.78"
										x2="5.64"
										y2="18.36"></line><line
										x1="18.36"
										y1="5.64"
										x2="19.78"
										y2="4.22"></line></svg
								>
							</button>
							<button
								type="button"
								class="theme-btn"
								data-theme="dark"
								aria-label="Dark mode"
							>
								<svg
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									><path
										d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
									></path></svg
								>
							</button>
							<button
								type="button"
								class="theme-btn"
								data-theme="system"
								aria-label="System theme"
							>
								<svg
									width="16"
									height="16"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
									></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
										x1="12"
										y1="17"
										x2="12"
										y2="21"></line></svg
								>
							</button>
						</div>
					</div>

					<CartBadge client:load />

					<details class="nav-menu">
						<summary class="nav-menu-toggle" aria-label="Open menu" aria-controls="nav-menu-panel">
							<span class="nav-menu-icon" aria-hidden="true"></span>
						</summary>
						<div class="nav-menu-panel" id="nav-menu-panel">
							{
								primaryNav.map((item) => (
									<a href={item.url}>{item.label}</a>
								))
							}
							<div class="nav-menu-auth">
								<AuthBadge client:load />
							</div>
							<div
								class="theme-switcher theme-switcher--menu"
								role="group"
								aria-label="Color theme"
							>
								<button
									type="button"
									class="theme-btn"
									data-theme="light"
									aria-label="Light mode"
								>
									<svg
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										><circle cx="12" cy="12" r="5"></circle><line
											x1="12"
											y1="1"
											x2="12"
											y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
										></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
										></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
										></line><line x1="1" y1="12" x2="3" y2="12"></line><line
											x1="21"
											y1="12"
											x2="23"
											y2="12"></line><line
											x1="4.22"
											y1="19.78"
											x2="5.64"
											y2="18.36"></line><line
											x1="18.36"
											y1="5.64"
											x2="19.78"
											y2="4.22"></line></svg
									>
								</button>
								<button
									type="button"
									class="theme-btn"
									data-theme="dark"
									aria-label="Dark mode"
								>
									<svg
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										><path
											d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
										></path></svg
									>
								</button>
								<button
									type="button"
									class="theme-btn"
									data-theme="system"
									aria-label="System theme"
								>
									<svg
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
										></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
											x1="12"
											y1="17"
											x2="12"
											y2="21"></line></svg
									>
								</button>
							</div>
						</div>
					</details>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo">
							{
								siteLogo ? (
									<img
										src={siteLogo.url}
										alt={siteLogo.alt || siteTitle}
										class="footer-logo-img"
									/>
								) : (
									siteTitle
								)
							}
						</a>
						{
							siteTagline && (
								<p class="footer-tagline">{siteTagline}</p>
							)
						}
					</div>
					<div class="footer-cols">
						<div class="footer-nav">
							<h2 class="footer-heading">Navigate</h2>
							<ul class="footer-links">
								<li><a href="/store">Store</a></li>
								<li><a href="/posts">Blog</a></li>
								<li><a href="/store/cart">Cart</a></li>
								<li><a href="/store/checkout">Checkout</a></li>
								{
									menu?.items.map((item) => (
										<li>
											<a
												href={item.url}
												target={item.target}
												rel={
													item.target === "_blank"
														? "noopener noreferrer"
														: undefined
												}
											>
												{item.label}
											</a>
										</li>
									))
								}
							</ul>
						</div>
						<div class="footer-nav">
							<h2 class="footer-heading">Connect</h2>
							<ul class="footer-links">
								<li><a href="/rss.xml">RSS Feed</a></li>
							</ul>
						</div>
						<div class="footer-widgets-section">
							<WidgetArea name="footer" />
						</div>
					</div>
				</div>
				<div class="footer-bottom">
					<p class="footer-copyright">
						Powered by <a href="https://emdashcms.com">EmDash</a>
					</p>
					<div class="theme-switcher">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Light mode"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><circle cx="12" cy="12" r="5"></circle><line
									x1="12"
									y1="1"
									x2="12"
									y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
								></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
								></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
								></line><line x1="1" y1="12" x2="3" y2="12"></line><line
									x1="21"
									y1="12"
									x2="23"
									y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
								></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
								></line></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Dark mode"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="System theme"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
								></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
									x1="12"
									y1="17"
									x2="12"
									y2="21"></line></svg
							>
						</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Theme switcher
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function setTheme(theme: string) {
				if (theme === "system") {
					setCookie("theme", "");
					root.classList.remove("light", "dark");
				} else {
					setCookie("theme", theme);
					root.classList.remove("light", "dark");
					root.classList.add(theme);
				}
				updateActiveBtn(theme);
			}

			function updateActiveBtn(theme: string) {
				themeBtns.forEach((btn) => {
					const active = btn.dataset.theme === theme;
					btn.classList.toggle("active", active);
					btn.setAttribute("aria-pressed", String(active));
				});
			}

			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			// Initialize
			const storedTheme = getStoredTheme();
			setTheme(storedTheme);

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					setTheme(btn.dataset.theme || "system");
				});
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					overflow-x: clip;
				}

				body {
					font-family: var(--font-body);
					overflow-x: clip;
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-text);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 65%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.nav {
				display: flex;
				align-items: center;
				gap: var(--spacing-6);
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4) var(--spacing-6);
				height: var(--nav-height);
			}

			.site-title {
				flex: 0 1 auto;
				min-width: 0;
				font-size: var(--font-size-lg);
				font-weight: 600;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.site-title:hover {
				color: var(--color-brand);
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-cluster {
				display: flex;
				align-items: center;
				gap: var(--spacing-5);
				flex: 1 1 auto;
				min-width: 0;
				margin-inline-start: auto;
				justify-content: flex-end;
			}

			.nav-toolbar {
				display: flex;
				align-items: center;
				gap: var(--spacing-4);
				flex-shrink: 0;
			}

			.nav-toolbar-extra {
				display: flex;
				align-items: center;
				gap: var(--spacing-4);
			}

			.nav-links {
				display: flex;
				align-items: center;
				gap: var(--spacing-5);
				flex-shrink: 0;
				font-size: var(--font-size-sm);
			}

			.nav-links a,
			.nav-menu-panel a {
				text-decoration: none;
				color: var(--color-text);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover,
			.nav-menu-panel a:hover {
				color: var(--color-brand);
			}

			.nav-menu {
				display: none;
				position: relative;
			}

			.theme-switcher--menu {
				display: none;
			}

			.nav-menu-toggle {
				list-style: none;
				display: grid;
				place-items: center;
				width: 40px;
				height: 40px;
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg);
				cursor: pointer;
			}

			.nav-menu-toggle::-webkit-details-marker {
				display: none;
			}

			.nav-menu-icon,
			.nav-menu-icon::before,
			.nav-menu-icon::after {
				display: block;
				width: 16px;
				height: 2px;
				background: var(--color-text);
				border-radius: 1px;
				transition:
					transform 0.2s ease,
					opacity 0.2s ease,
					top 0.2s ease;
			}

			.nav-menu-icon {
				position: relative;
			}

			.nav-menu-icon::before,
			.nav-menu-icon::after {
				content: "";
				position: absolute;
				left: 0;
			}

			.nav-menu-icon::before {
				top: -5px;
			}

			.nav-menu-icon::after {
				top: 5px;
			}

			.nav-menu-panel {
				display: grid;
				gap: 0.25rem;
				position: absolute;
				top: calc(100% + 0.5rem);
				right: 0;
				min-width: 11rem;
				padding: 0.5rem;
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				box-shadow: var(--shadow-md, 0 8px 24px rgb(0 0 0 / 12%));
				z-index: 120;
			}

			.nav-menu-panel a {
				display: block;
				padding: 0.625rem 0.75rem;
				font-size: var(--font-size-sm);
				border-radius: calc(var(--radius) - 2px);
			}

			.nav-menu-panel a:hover {
				background: var(--color-bg-subtle);
			}

			.nav-menu-auth {
				padding: 0.5rem 0.75rem;
				border-top: 1px solid var(--color-border-subtle);
				margin-top: 0.25rem;
			}

			/* Search styling */
			.site-search-wrap {
				flex: 0 1 14rem;
				width: 14rem;
				max-width: 16rem;
				min-width: 10rem;
			}

			.site-search-wrap :global(.site-search) {
				position: relative;
				display: block;
				width: 100%;
				--emdash-search-border-focus: var(--color-brand);
			}

			.site-search-wrap :global(.site-search-input) {
				width: 100%;
				padding: var(--spacing-2) var(--spacing-3);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.site-search-wrap :global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			.site-search-wrap :global(.site-search-input):focus,
			.site-search-wrap :global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			.site-search-wrap :global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer */
			.site-footer {
				background: var(--color-bg-subtle);
				border-top: 1px solid var(--color-border-subtle);
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-16) var(--spacing-6) var(--spacing-8);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.4fr) minmax(0, 2fr);
				gap: var(--spacing-12);
				margin-bottom: var(--spacing-10);
				align-items: start;
			}

			.footer-cols {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: var(--spacing-8);
			}

			.footer-brand {
				max-width: 280px;
			}

			.footer-logo {
				font-size: var(--font-size-lg);
				font-weight: 600;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				margin: var(--spacing-3) 0 0;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				line-height: var(--leading-relaxed);
			}

			.footer-nav {
				min-width: 0;
			}

			.footer-heading {
				font-size: var(--font-size-xs);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: var(--color-muted);
				margin: 0 0 var(--spacing-4);
			}

			.footer-links {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				gap: var(--spacing-2);
			}

			.footer-links li {
				margin: 0;
			}

			.footer-links a {
				color: var(--color-text-secondary);
				text-decoration: none;
				font-size: var(--font-size-sm);
				transition: color var(--transition-fast);
			}

			.footer-links a:hover {
				color: var(--color-text);
			}

			.footer-widgets-section:empty,
			.footer-widgets-section:not(:has(*)) {
				display: none;
			}

			.footer-widgets-section :global(.widget-area) {
				display: block;
			}

			.footer-widgets-section :global(.widget) {
				color: var(--color-text-secondary);
			}

			.footer-widgets-section :global(.widget__title) {
				font-size: var(--font-size-xs);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
			}

			.footer-widgets-section :global(.widget__content) {
				color: var(--color-text-secondary);
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--spacing-4);
				padding-top: var(--spacing-6);
				border-top: 1px solid var(--color-border);
			}

			.footer-copyright {
				margin: 0;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-copyright a {
				color: var(--color-text-secondary);
			}

			/* Theme switcher */
			.theme-switcher {
				display: flex;
				gap: var(--spacing-1);
				padding: var(--spacing-1);
				background: var(--color-surface);
				border-radius: var(--radius);
			}

			.theme-switcher--nav {
				flex-shrink: 0;
				border: 1px solid var(--color-border);
			}

			.theme-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 28px;
				background: transparent;
				border: none;
				color: var(--color-muted);
				border-radius: var(--radius);
				cursor: pointer;
				transition: all var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text-secondary);
			}

			.theme-btn.active {
				background: var(--color-bg);
				color: var(--color-text);
				box-shadow: var(--shadow-sm);
			}

			.theme-btn svg {
				width: 16px;
				height: 16px;
			}

			@media (max-width: 900px) {
				.footer-grid {
					grid-template-columns: 1fr;
					gap: var(--spacing-8);
					margin-bottom: var(--spacing-8);
				}

				.footer-brand {
					max-width: none;
				}

				.footer-cols {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: var(--spacing-6) var(--spacing-4);
				}

				.footer-widgets-section {
					grid-column: 1 / -1;
				}

				.nav {
					display: grid;
					grid-template-columns: minmax(0, 1fr) auto;
					align-items: center;
					column-gap: var(--spacing-3);
					row-gap: var(--spacing-3);
					height: auto;
					padding: var(--spacing-3) var(--spacing-4);
				}

				.site-title {
					grid-column: 1;
					grid-row: 1;
					font-size: var(--font-size-base);
					max-width: none;
				}

				.nav-toolbar {
					grid-column: 2;
					grid-row: 1;
					margin-inline-start: 0;
					gap: var(--spacing-2);
				}

				.nav-toolbar-extra {
					display: none;
				}

				.nav-cluster {
					grid-column: 1 / -1;
					grid-row: 2;
					margin-inline-start: 0;
					justify-content: stretch;
				}

				.site-search-wrap {
					width: 100%;
					max-width: none;
					flex: 1 1 auto;
					min-width: 0;
				}

				.nav-links {
					display: none;
				}

				.nav-menu {
					display: block;
				}

				/* backdrop-filter on header traps position:fixed — disable while open */
				.site-header:has(.nav-menu[open]) {
					position: fixed;
					inset: 0;
					z-index: 300;
					height: 100dvh;
					max-height: 100dvh;
					background: var(--color-bg);
					backdrop-filter: none;
					-webkit-backdrop-filter: none;
					border-bottom: none;
					overflow: hidden;
				}

				.site-header:has(.nav-menu[open]) .nav {
					height: 100%;
					max-width: none;
					padding: 0;
					display: block;
				}

				.site-header:has(.nav-menu[open]) .site-title,
				.site-header:has(.nav-menu[open]) .nav-cluster,
				.site-header:has(.nav-menu[open]) .nav-toolbar > :not(.nav-menu) {
					display: none;
				}

				.site-header:has(.nav-menu[open]) .nav-toolbar {
					display: contents;
				}

				.nav-menu[open] {
					position: absolute;
					inset: 0;
					z-index: 1;
					display: flex;
					flex-direction: column;
					width: 100%;
					height: 100%;
					background: var(--color-bg);
					animation: nav-menu-in 0.2s ease;
				}

				@keyframes nav-menu-in {
					from {
						transform: translateY(0.75rem);
					}
					to {
						transform: none;
					}
				}

				.nav-menu[open] .nav-menu-toggle {
					position: absolute;
					top: max(0.75rem, env(safe-area-inset-top));
					right: max(1rem, env(safe-area-inset-right));
					z-index: 2;
					background: var(--color-surface);
				}

				.nav-menu[open] .nav-menu-icon {
					background: transparent;
				}

				.nav-menu[open] .nav-menu-icon::before {
					top: 0;
					transform: rotate(45deg);
				}

				.nav-menu[open] .nav-menu-icon::after {
					top: 0;
					transform: rotate(-45deg);
				}

				.nav-menu[open] .nav-menu-panel {
					--nav-menu-link-size: clamp(1.5rem, 6vw, 1.875rem);
					position: static;
					flex: 1;
					display: flex;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					gap: 0;
					width: 100%;
					min-width: 0;
					max-width: 22rem;
					margin: 0 auto;
					padding: 5rem var(--spacing-6) var(--spacing-10);
					border: none;
					border-radius: 0;
					box-shadow: none;
					background: var(--color-bg);
					overflow-y: auto;
					text-align: center;
				}

				.nav-menu[open] .nav-menu-panel > a,
				.nav-menu[open] .nav-menu-auth {
					display: flex;
					align-items: center;
					justify-content: center;
					width: 100%;
					margin: 0;
					padding: 1rem 0.5rem;
					border: none;
					border-bottom: 1px solid var(--color-border-subtle);
					border-radius: 0;
					font-size: var(--nav-menu-link-size);
					font-weight: var(--font-weight-heading, 600);
					letter-spacing: var(--tracking-snug);
					line-height: 1.2;
					text-decoration: none;
					color: var(--color-text);
				}

				.nav-menu[open] .nav-menu-panel > a:hover,
				.nav-menu[open] .nav-menu-auth :global(.auth-badge):hover,
				.nav-menu[open] .nav-menu-auth :global(.auth-badge--user button):hover {
					background: transparent;
					color: var(--color-brand);
				}

				.nav-menu[open] .nav-menu-auth :global(.auth-badge),
				.nav-menu[open] .nav-menu-auth :global(.auth-badge--user),
				.nav-menu[open] .nav-menu-auth :global(.auth-badge--user button) {
					display: flex;
					align-items: center;
					justify-content: center;
					width: 100%;
					margin: 0;
					padding: 0;
					border: none;
					font-size: inherit;
					font-weight: inherit;
					letter-spacing: inherit;
					line-height: inherit;
					text-decoration: none;
					color: inherit;
					background: transparent;
					cursor: pointer;
				}

				.theme-switcher--menu {
					display: flex;
					width: fit-content;
					margin: 1.75rem auto 0;
					justify-content: center;
					border: 1px solid var(--color-border);
				}

				.nav-toolbar :global(.cart-badge) {
					font-size: var(--font-size-sm);
				}

				body:has(.nav-menu[open]) {
					overflow: hidden;
				}
			}

			@media (max-width: 640px) {
				.site-header {
					position: sticky;
				}

				.footer-inner {
					padding: var(--spacing-8) var(--spacing-4) var(--spacing-5);
				}

				.footer-grid {
					gap: var(--spacing-6);
					margin-bottom: var(--spacing-6);
				}

				.footer-brand {
					text-align: center;
					padding-bottom: var(--spacing-5);
					border-bottom: 1px solid var(--color-border-subtle);
				}

				.footer-tagline {
					margin-inline: auto;
					max-width: 22rem;
				}

				.footer-cols {
					grid-template-columns: 1fr 1fr;
					gap: var(--spacing-5) var(--spacing-4);
				}

				.footer-heading {
					margin-bottom: var(--spacing-3);
				}

				.footer-links {
					gap: 0.35rem;
				}

				.footer-bottom {
					flex-direction: column;
					justify-content: center;
					align-items: center;
					gap: var(--spacing-3);
					padding-top: var(--spacing-5);
					text-align: center;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input",
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});

			// Mobile full-screen menu: close on link, Escape; sync toggle label
			const navMenu = document.querySelector(".nav-menu");
			if (navMenu instanceof HTMLDetailsElement) {
				const toggle = navMenu.querySelector(".nav-menu-toggle");
				const syncToggle = () => {
					if (!(toggle instanceof HTMLElement)) return;
					toggle.setAttribute(
						"aria-label",
						navMenu.open ? "Close menu" : "Open menu",
					);
				};
				syncToggle();
				navMenu.addEventListener("toggle", syncToggle);
				navMenu.querySelectorAll("a").forEach((link) => {
					link.addEventListener("click", () => {
						navMenu.open = false;
					});
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && navMenu.open) {
						navMenu.open = false;
					}
				});
			}
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
